# Normalize line endings to LF in the repository. Windows checkouts still get
# CRLF locally via core.autocrlf, but CI and diffs stay stable.
* text=auto eol=lf

# Windows-only files that some tooling requires to keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Lockfiles are generated; collapse them in diffs and reviews
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff

# Generated by tauri-specta. Tracked so a fresh clone typechecks, but marked
# generated so it does not skew language stats or clutter reviews.
src/lib/bindings.ts linguist-generated=true
