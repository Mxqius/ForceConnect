{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForceConnect",
  "version": "2.1.2",
  "identifier": "com.mxqius.force-connect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForceConnect",
        "width": 1000,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Mxqius",
    "copyright": "Copyright (c) Mxqius",
    "category": "Utility",
    "shortDescription": "A fast, modern DNS manager",
    "longDescription": "Switch DNS servers, manage network interfaces, and route queries through encrypted DNS protocols from a clean, lightweight interface.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNTk4NTVDNTg4RUMxQzEKUldUQndZNVlYSVZad1Q1V0VHZlhjSjJhb3BXL05yQ0VzMFFXYmRPLzJBL3NMaTFFR01xSGttRDUK",
      "endpoints": [
        "https://github.com/mxqius/forceconnect/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
